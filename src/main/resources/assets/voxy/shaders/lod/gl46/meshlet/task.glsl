#version 460 core
#extension GL_NV_mesh_shader : require

layout(local_size_x = 1) in;

struct DrawCommand {
    uint  count;
    uint  instanceCount;
    uint  firstIndex;
    int  baseVertex;
    uint  baseInstance;
};

layout(binding = 0, std140) uniform SceneUniform {
    mat4 MVP;
    ivec3 baseSectionPos;
    uint frameId;
    vec3 cameraSubPos;
};

// Binding 7: Draw command buffer containing MDIC draw calls generated by cmdgen.comp
layout(binding = 7, std430) readonly restrict buffer TaskDrawBuffer {
    DrawCommand cmdBuffer[];
};

// Binding 6: Indirect section lookup buffer (section ID map)
layout(binding = 6, std430) readonly restrict buffer TaskIndirectSectionLookup {
    uint sectionCount;
    uint indirectLookup[];
};

// Task payload sent to mesh shader workgroups
taskNV out TaskPayload {
    uint sectionId;
    uint quadStart;
    uint quadCount;
    uint drawId;
} taskOut;

// Uniforms to specify draw types and offsets
layout(location = 0) uniform uint commandOffset;
layout(location = 1) uniform uint drawType; // 0 = Opaque, 1 = Translucent, 2 = Temporal

void main() {
    uint drawIndex = gl_WorkGroupID.x;

    DrawCommand cmd = cmdBuffer[commandOffset + drawIndex];
    uint quadCount = cmd.count / 6;
    uint quadStart = uint(cmd.baseVertex) >> 2;
    uint drawId = cmd.baseInstance;

    if (quadCount == 0) {
        gl_TaskCountNV = 0;
        return;
    }

    taskOut.sectionId = indirectLookup[drawId];
    taskOut.quadStart = quadStart;
    taskOut.quadCount = quadCount;
    taskOut.drawId = drawId;

    // Dispatch 1 mesh shader workgroup per 16 quads
    gl_TaskCountNV = (quadCount + 15) / 16;
}

